# voice-stt 설정 파일 (템플릿)
# ─────────────────────────────────────────────────────────────────────────────
# 이 파일은 git에 추적되는 템플릿입니다. 실제 사용되는 config.toml은
# 첫 실행 시 이 파일이 자동으로 복사되며, 이후 변경은 컴퓨터마다 독립적입니다.
# 변경 후 앱 메뉴 > 설정... 에서 저장하거나 파일을 직접 수정하고 앱을 재시작하세요.
# ─────────────────────────────────────────────────────────────────────────────


# ── 단축키 ────────────────────────────────────────────────────────────────────

# 누르는 동안 녹음, 떼면 STT 전송하는 트리거 키
# 기본값: "right_option"
# macOS 선택지: "right_option" | "right_cmd" | "right_shift" | "right_ctrl"
# Windows 선택지: "right_alt" | "right_ctrl" | "right_shift"
# 참고: macOS "right_option" 과 Windows "right_alt" 는 같은 물리 키이므로
#       이 값 그대로 Windows에서도 동작합니다.
shortcut = "right_option"

# STT 인식 언어 코드 (BCP-47 형식)
# 기본값: "ko"
# 예시: "ko" (한국어), "en" (영어), "ja" (일본어), "zh" (중국어)
language = "ko"

# 인식 정확도를 높일 도메인 키워드 목록
# 기본값: [] (없음)
# 고유명사·전문용어를 넣으면 오인식이 줄어든다. 최대 100개.
# 예시: ["VideoStew", "Claude", "GPT-4"]
keyterms = []


# ── 텍스트 후처리 ─────────────────────────────────────────────────────────────

# 필러 단어 자동 제거 여부 (um, uh, 어, 음, 그 등)
# 기본값: true
# true  → ElevenLabs 서버 측에서 필러 단어를 제거한 결과 반환
# false → 발화 그대로 받아쓰기 (회의록·인터뷰 등 원문이 필요한 경우)
no_verbatim = true


# ── 오디오 ────────────────────────────────────────────────────────────────────

# 녹음 중 시스템 오디오 자동 음소거 여부
# 기본값: true
# true  → 녹음 시작 시 스피커를 음소거하고 종료 시 복원
# false → 음소거 없이 녹음 (에코·피드백이 없는 헤드셋 환경 등)
# 참고: 현재 macOS에서만 동작합니다. Windows에서는 이 값을 무시합니다.
mute_during_recording = true


# ── 연속입력 모드 ─────────────────────────────────────────────────────────────

# 연속입력 모드를 활성화/비활성화하는 글로벌 단축키
# 기본값: "ctrl+option+t"
# macOS 형식: 수식어(ctrl/option/shift/cmd) + 알파벳/숫자, "+" 로 조합
# Windows 형식: 수식어(ctrl/alt/shift) + 알파벳/숫자 — "option" = "alt" 로 인식
# 비워두면("") 연속입력 단축키가 비활성화된다.
continuous_shortcut = "ctrl+option+t"

# 연속입력 직전에 자동으로 누를 키 (현재 포커스된 앱에 전달됨)
# 기본값: "enter"
# 채팅 앱에서 입력 중이던 텍스트를 먼저 전송하고 싶을 때 유용하다.
# 예시: "enter" (전송), "tab" (다음 필드 이동), "" (없음)
continuous_before_key = ""

# 붙여넣기 직후에 자동으로 누를 키
# 기본값: "enter"
# 붙여넣은 텍스트를 바로 전송하고 싶을 때 유용하다.
# 예시: "enter" (전송), "tab" (다음 필드), "" (없음)
continuous_after_key = ""


# ── 음성 감지 (VAD) ───────────────────────────────────────────────────────────

# 마이크 입력 감도 임계값 (RMS 기준)
# 기본값: 500 / 범위: 100 ~ 5000 (정수)
# 낮을수록 민감 → 작은 소리도 음성으로 인식 (조용한 환경 권장)
# 높을수록 둔감 → 배경 소음을 무시 (시끄러운 환경 권장)
# 참고: 마이크/환경에 따라 다르므로 첫 실행 후 로그의 "VAD 진단" 항목을 보고 조정.
vad_threshold = 1500

# 음성이 끊긴 후 STT 전송까지 대기하는 침묵 시간 (초)
# 기본값: 1.0 / 범위: 0.3 ~ 5.0
# 짧게 → 말을 빨리 끝냈을 때 빠른 반응 (단, 말 중간 끊김 주의)
# 길게 → 문장 사이 짧은 멈춤에도 계속 녹음
vad_silence_sec = 1.0


# ── 키 트리거 ─────────────────────────────────────────────────────────────────

# 텍스트에 특정 키워드가 포함되면 해당 키를 트리거하는 매핑
# 기본값: {} (없음)
# 키워드는 텍스트에서 자동으로 제거되고, 붙여넣기 후 매핑된 키가 눌린다.
# 연속입력 모드(VAD)에서만 적용된다.
# 사용 가능한 키: enter, tab, esc, space, f1~f12, 단일 문자(a, 1 등)
# 조합키는 "+"로 연결: alt+tab, cmd+w, ctrl+shift+t 등
#
# 예시:
#   "엔터" = "enter"       → "안녕하세요 엔터" 발화 시 "안녕하세요" 붙여넣기 후 Enter
#   "탭" = "tab"           → "다음 항목 탭" 발화 시 "다음 항목" 붙여넣기 후 Tab
#   "알트탭" = "alt+tab"   → "알트탭" 발화 시 텍스트 없이 Alt+Tab 실행
[custom_key_trigger]
# "엔터" = "enter"
# "탭" = "tab"
# "에스케이프" = "esc"
# "알트탭" = "alt+tab"
"엔터" = "enter"
