# KeyScribe 설정 파일 (템플릿)
# ─────────────────────────────────────────────────────────────────────────────
# 이 파일은 git에 추적되는 템플릿입니다. 실제 사용되는 config.toml은
# macOS 첫 실행 시에는 단축키를 right_command로 바꿔 복사합니다.
# 이후 변경은 컴퓨터마다 독립적입니다.
# 변경 후 앱 메뉴 > 설정... 에서 저장하세요.
# ─────────────────────────────────────────────────────────────────────────────


# ── 단축키 ────────────────────────────────────────────────────────────────────

# 녹음을 시작하는 트리거 키 (종료 방식은 recording_control에서 선택)
# 기본값: macOS "right_command", Windows "right_option"
# 실제 앱 설정 화면에서 현재 OS에서 쓸 수 있는 키를 목록으로 선택할 수 있습니다.
# macOS: 좌/우 Option, Command, Control, Shift
# Windows: 좌/우 Alt, Ctrl, Shift
shortcut = "right_option"

# hold: 키를 놓으면 녹음 종료 / toggle: 다시 누르면 녹음 종료
recording_control = "hold"

# 녹음 시간 제한: 10, 20, 30, 60분 중 선택 (기본값: 30분)
# 시간이 지나면 녹음을 종료하고, 그때까지 녹음된 내용은 전사합니다.
recording_time_limit_minutes = 30

# 붙여넣기 직후 Enter를 눌러 메시지를 자동 전송할지 여부
auto_send = true

# STT 인식 언어 코드 (ISO 639-1)
# 설정 화면에서 수십 개 언어를 선택할 수 있습니다.
# UI는 ko/en/ja/zh/es 선택 시 각각 한국어/영어/일본어/중국어/스페인어로 표시하며,
# 그 외 전사 언어에서는 영어로 표시됩니다.
language = "ko"

# 인식 정확도를 높일 도메인 키워드 목록
# 기본값: [] (없음)
# 고유명사·전문용어를 넣으면 오인식이 줄어든다. 최대 100개.
# 예시: ["VideoStew", "후잉", "GPT-4"]
keyterms = ["비디오스튜","후잉"]


# ── 텍스트 후처리 ─────────────────────────────────────────────────────────────

# 필러 단어 자동 제거 여부 (um, uh, 어, 음, 그 등)
# 기본값: true
# true  → ElevenLabs 서버 측에서 필러 단어를 제거한 결과 반환
# false → 발화 그대로 받아쓰기 (회의록·인터뷰 등 원문이 필요한 경우)
no_verbatim = true

# ── 전사 모델 ────────────────────────────────────────────────────────────────

# API 키 접두사에 따라 서비스가 자동 선택됩니다.
# OpenAI: sk-..., ElevenLabs: sk_..., Groq: gsk_...
openai_model = "gpt-transcribe"
elevenlabs_model = "scribe_v2"
groq_model = "whisper-large-v3-turbo"


# ── 오디오 ────────────────────────────────────────────────────────────────────

# 녹음 중 시스템 오디오 자동 음소거 여부
# 기본값: true
# true  → 녹음 시작 시 스피커를 음소거하고 종료 시 복원
# false → 음소거 없이 녹음 (에코·피드백이 없는 헤드셋 환경 등)
# macOS와 Windows에서 동작합니다.
mute_during_recording = true

# 녹음 시작 효과음 음량: 0은 끔, 100은 기본, 최대 200 (%)
recording_start_sound_volume = 100


# ── 녹음 위젯 ─────────────────────────────────────────────────────────────────

# 녹음/변환 상태를 보여주는 위젯이 화면 어디에 뜰지 선택합니다.
# 기본값: "bottom_center"
# top_left, top_center, top_right, center, bottom_left, bottom_center, bottom_right
# 마우스 커서가 있는 화면(모니터)의 작업 영역을 기준으로 배치합니다.
overlay_position = "bottom_center"
